```gitignore
# WordPress specific
wp-content/cache/
*.log
*.tmp

# Dependencies
node_modules/
vendor/

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# System
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Build artifacts
dist/
build/
target/
*.pyc
__pycache__/
*.class
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```